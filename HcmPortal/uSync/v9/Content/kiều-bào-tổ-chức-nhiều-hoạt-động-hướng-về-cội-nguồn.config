<Content Key="5b4065b7-8418-4266-8924-743eb4756c9c" Alias="Kiều bào tổ chức nhiều hoạt động hướng về cội nguồn" Level="4">
  <Info>
    <Parent Key="7094342f-248e-4814-b944-047f5e8b6381">Bạn bè quốc tế</Parent>
