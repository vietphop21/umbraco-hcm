<Content Key="bbd1fce8-6872-432f-adb3-1de4e39cbbd6" Alias="Bạn bè quốc tế viết về vị lãnh tụ của nhân dân Việt Nam" Level="4">
  <Info>
    <Parent Key="7094342f-248e-4814-b944-047f5e8b6381">Bạn bè quốc tế</Parent>
