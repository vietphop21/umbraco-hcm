      <Value><![CDATA[2026-09-20T20:32:34]]></Value>
    </publishDate>
    <source>
      <Value><![CDATA[Phóng viên]]></Value>
    </source>
    <summary>
      <Value><![CDATA[Từ khi thành lập Đảng đến Cách mạng Tháng Tám và ngày khai sinh nước Việt Nam Dân chủ Cộng hòa.]]></Value>
    </summary>
