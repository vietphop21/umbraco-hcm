<Content Key="2df489d0-c219-4eb1-becc-891f1d17dc20" Alias="Vận dụng phong cách quần chúng trong công tác cán bộ" Level="4">
  <Info>
    <Parent Key="6cef87da-59ed-45a4-8db8-7d16a045b3ec">Nội dung tư tưởng đạo đức</Parent>
