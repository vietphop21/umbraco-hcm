<Content Key="4204ddd3-ab75-4b36-afb3-ffe4640536a1" Alias="Giáo dục tư tưởng vì dân cho thế hệ trẻ" Level="4">
  <Info>
    <Parent Key="f31bf2e4-2e06-46a5-8716-fe03f19cef66">Nghiên cứu</Parent>
