<Content Key="539c72c1-18de-4794-a3ff-1cd040bd6f03" Alias="Hoạt động ngoại giao trong những năm đầu xây dựng nhà nước mới" Level="4">
  <Info>
    <Parent Key="f54f72dc-3dee-449b-9a62-274ac9bff21c">Hoạt động quốc tế</Parent>
