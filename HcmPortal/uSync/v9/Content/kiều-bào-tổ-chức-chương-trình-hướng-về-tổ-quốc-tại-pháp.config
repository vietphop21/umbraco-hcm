<Content Key="0ff059b5-5d43-4b15-9c1c-3aa8a7aa3e1a" Alias="Kiều bào tổ chức chương trình hướng về Tổ quốc tại Pháp" Level="4">
  <Info>
    <Parent Key="f54f72dc-3dee-449b-9a62-274ac9bff21c">Hoạt động quốc tế</Parent>
