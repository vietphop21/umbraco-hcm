@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    var type = Model.ContentType.Alias;
    var parent = Model.Parent;
    const int RelatedMin = 4;
    const int RelatedMax = 48;
    const int RelatedPageSize = 12;
    const int ShortBodyCardCount = 12;
    const int ShortBody = 600;
    var plainBody = System.Text.RegularExpressions.Regex.Replace(Model.Value<string>(Props.BodyText) ?? "", "<[^>]+>", " ").Trim();
    // Bài ngắn: hiện thêm thẻ liên quan để cột chính cân với cột phải.
    var cardCount = plainBody.Length < ShortBody ? ShortBodyCardCount : RelatedMin;
    var relatedPool = parent?.Items(RelatedMax).Where(x => x.Id != Model.Id).Take(RelatedMax).ToList() ?? new();
    var sameSectionCount = relatedPool.Count;
    if (relatedPool.Count < RelatedMax)
        relatedPool.AddRange(Model.Root().Items(RelatedMax * 3)
            .Where(x => x.Id != Model.Id && relatedPool.All(r => r.Id != x.Id))
            .Take(RelatedMax - relatedPool.Count));
    var relatedPageCount = Math.Max(1, (int)Math.Ceiling(relatedPool.Count / (double)RelatedPageSize));
    int.TryParse(Context.Request.Query["relatedPage"], out var relatedPage);
    relatedPage = Math.Clamp(relatedPage, 1, relatedPageCount);
    var related = relatedPool.Skip((relatedPage - 1) * RelatedPageSize).Take(RelatedPageSize).ToList();
    var relatedTitle = relatedPool.Count > sameSectionCount ? "Tư liệu liên quan" : "Tin cùng chuyên mục";
    var usedImages = new HashSet<string>();
    ViewData["UsedContentImages"] = usedImages;

    // Đoạn mở đầu trùng sapo thì không lặp lại trong thân bài.
    var summaryText = Model.Value<string>(Props.Summary)?.Trim();
    var bodyHtml = Model.Value<string>(Props.BodyText) ?? string.Empty;
    if (!string.IsNullOrEmpty(summaryText) && bodyHtml.TrimStart().StartsWith($"<p>{summaryText}</p>"))
        bodyHtml = bodyHtml.TrimStart()[$"<p>{summaryText}</p>".Length..];
    var youtube = SiteHelpers.YoutubeEmbed(Model.Value<string>("youtubeUrl"));
    var videoFile = Model.Value<IPublishedContent>("videoFile")?.Url();
    var audioFile = Model.Value<IPublishedContent>("audioFile")?.Url();
    var photos = Model.Value<IEnumerable<IPublishedContent>>("photos") ?? Enumerable.Empty<IPublishedContent>();
    var d = Model.Date();
}
<div class="container page-wrap">
    <div class="two-col">
        <article class="detail">
            @if (parent != null) { <h2 class="sec-title line"><a href="@parent.Url()">@parent.Name @SiteHelpers.CountBadge(parent.ItemCount())</a></h2> }
            <div class="detail-tools">
                <time>@SiteHelpers.DayName(d), @d.ToString("dd/MM/yyyy") | @d.ToString("HH:mm")</time>
                <div class="tools">
                    <button data-font="-1" title="@SiteHelpers.T("Giảm cỡ chữ")">A<sup>-</sup></button>
                    <button data-font="0" title="@SiteHelpers.T("Cỡ chữ mặc định")">A</button>
                    <button data-font="1" title="@SiteHelpers.T("Tăng cỡ chữ")">A<sup>+</sup></button>
                    <span class="sep"></span>
                    <button onclick="window.print()" title="@SiteHelpers.T("In bài viết")"><i class="fa fa-print"></i></button>
                    <a href="mailto:?subject=@Uri.EscapeDataString(Model.Name ?? "")&body=@Uri.EscapeDataString(Context.Request.Scheme + "://" + Context.Request.Host + Model.Url())" title="@SiteHelpers.T("Gửi email")"><i class="fa fa-envelope"></i></a>
                    <button onclick="navigator.clipboard.writeText(location.href);this.title='@SiteHelpers.T("Đã sao chép")'" title="@SiteHelpers.T("Sao chép liên kết")"><i class="fa fa-link"></i></button>
                    <button type="button" data-qr title="@SiteHelpers.T("Mã QR chia sẻ")" aria-label="@SiteHelpers.T("Mã QR chia sẻ")"><i class="fa fa-qrcode"></i></button>
                </div>
            </div>

            <div class="qr-pop" hidden>
                <div class="qr-box"></div>
                <p>@SiteHelpers.T("Quét mã để mở tài liệu trên điện thoại")</p>
                <button type="button" data-qr-close>@SiteHelpers.T("Đóng")</button>
            </div>
            <h1>@Model.Name</h1>
            @if (Model.HasValue("summary")) { <p class="detail-sapo">@Model.Value("summary")</p> }

            @if (type == DocTypes.Video && (youtube != null || videoFile != null))
            {
                <div class="player">
                    @if (youtube != null) { <iframe src="@youtube" allowfullscreen allow="autoplay; encrypted-media"></iframe> }
                    else { <video controls preload="metadata" poster="@Model.Img(960, 540)" src="@videoFile"></video> }
                </div>
            }
            @if (type == DocTypes.Audio && audioFile != null)
            {
                <div class="audio-box">
                    @if (Model.Img(200, 200) is string cover) { <img src="@cover" alt="" /> }
                    <div>
                        <strong><i class="fa fa-headphones"></i> @SiteHelpers.T("Nghe audio")</strong>
                        <audio class="audio-player" controls preload="metadata" src="@audioFile"></audio>
                    </div>
                </div>
            }
            @if (type == "photoAlbum" && photos.Any())
            {
                <div class="grid g3 album">
                    @foreach (var p in photos)
                    {
                        <a class="glightbox" data-gallery="album" href="@p.GetCropUrl(width: 1600)">
                            <img src="@p.GetCropUrl(width: 480, height: 320, imageCropMode: ImageCropMode.Crop)" alt="@p.Name" loading="lazy" />
                        </a>
                    }
                </div>
            }

            @if (type == DocTypes.PdfDocument)
            {
                var pdfUrl = Model.Value<IPublishedContent>(LibraryProps.PdfFile)?.Url();
                if (Model.HasValue(LibraryProps.Author)) { <p class="pdf-author"><i class="fa fa-user-pen"></i> @Model.Value(LibraryProps.Author)</p> }
                @if (pdfUrl != null)
                {
                    <div class="flipbook" data-pdf="@pdfUrl" data-loading="@SiteHelpers.T("Đang tải tài liệu...")" data-error="@SiteHelpers.T("Không mở được tài liệu.")">
                        <div class="flipbook-stage"><p class="flipbook-status"><i class="fa fa-spinner fa-spin"></i> @SiteHelpers.T("Đang tải tài liệu...")</p></div>
                        <div class="flipbook-nav">
                            <button type="button" data-flip="prev" aria-label="@SiteHelpers.T("Trang trước")"><i class="fa fa-chevron-left"></i></button>
                            <span class="flipbook-page"></span>
                            <button type="button" data-flip="next" aria-label="@SiteHelpers.T("Trang sau")"><i class="fa fa-chevron-right"></i></button>
                        </div>
                        <p class="flipbook-note"><i class="fa fa-lock"></i> @SiteHelpers.T("Tài liệu chỉ được xem trực tuyến, không cho phép tải về.")</p>
                    </div>
                }
            }
            @if (Model.Coordinates() is { } pos)
            {
                <div class="place-embed">
                    <iframe src="@SiteHelpers.MapEmbedUrl(pos.Lat, pos.Lng)" title="@SiteHelpers.T("Bản đồ") @Model.Name" loading="lazy"></iframe>
                </div>
            }
            @{ var linkedPeriods = Model.LinkedPeriods().ToList(); }
            @if (linkedPeriods.Any())
            {
                <p class="lib-meta detail-periods"><b>@SiteHelpers.T("Thuộc giai đoạn"):</b>
                    @foreach (var p in linkedPeriods) { <a class="period-chip" href="@p.Url()">@p.Name</a> }
                </p>
            }

            <div class="detail-body" id="detail-body">@Html.Raw(bodyHtml)</div>
            @if (Model.HasValue("source")) { <p class="source">@Model.Value("source")</p> }

            @if (related.Any())
            {
                <div class="related" id="related-materials">
                    <h2 class="sec-title line">@SiteHelpers.T(relatedTitle)</h2>
                    <div class="grid g4">
                        @foreach (var x in related.Take(cardCount))
                        {
                            <article class="item-v">
                                <a class="thumb" href="@x.Url()">
                                    @if (x.ContentImage(400, 250, usedImages) is string img) { <img src="@img" alt="@x.Name" loading="lazy" /> } else { <span class="noimg"><i class="fa fa-image"></i></span> }
                                </a>
                                <h3><a href="@x.Url()">@x.Name</a></h3>
                            </article>
                        }
                    </div>
                    <ul class="related-list">
                        @foreach (var x in related.Skip(cardCount)) { <li><a href="@x.Url()">@x.Name</a> <time>(@x.Date().ToString("dd/MM/yyyy"))</time></li> }
                    </ul>
                    @if (relatedPageCount > 1)
                    {
                        <nav class="pager related-pager" aria-label="@SiteHelpers.T("Phân trang tư liệu liên quan")">
                            @if (relatedPage > 1) { <a href="@(Model.Url() + "?relatedPage=" + (relatedPage - 1) + "#related-materials")">‹</a> }
                            @for (var rp = 1; rp <= relatedPageCount; rp++)
                            {
                                <a class="@(rp == relatedPage ? "active" : "")" href="@(Model.Url() + "?relatedPage=" + rp + "#related-materials")">@rp</a>
                            }
                            @if (relatedPage < relatedPageCount) { <a href="@(Model.Url() + "?relatedPage=" + (relatedPage + 1) + "#related-materials")">›</a> }
                        </nav>
                    }
                </div>
            }
        </article>
        <partial name="Site/Sidebar" />
    </div>
</div>

<partial name="Site/OtherSections" />
