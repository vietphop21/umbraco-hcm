@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@*
    Cột phải dùng chung: Phim tư liệu, Hình ảnh tư liệu, Sách nói (theo cấu hình node Trang chủ) và lối tắt tới các chức năng chính.
    Giữ gọn để cột phải không dài hơn nhiều so với nội dung chính.
*@
@{
    const int VideoCount = 3;
    const int PhotoCount = 2;
    const int AudioCount = 3;

    var home = Model.Root();
    var usedImages = ViewData["UsedContentImages"] as HashSet<string> ?? new HashSet<string>();
    var blocks = new (IPublishedContent? Section, int Count, string Icon)[]
    {
        (home.Picked("videoSection"), VideoCount, "fa-play"),
        (home.Picked("photoSection"), PhotoCount, "fa-camera"),
        (home.Picked("audioSection"), AudioCount, "fa-volume-high"),
    };
    var shortcuts = new (string UrlName, string Label, string Icon)[]
    {
        (SiteMap.Search, "Tra cứu đa tiêu chí", "fa-magnifying-glass"),
        (SiteMap.Periods, "Cây thư mục giai đoạn", "fa-sitemap"),
        (SiteMap.Media, "Thư viện tư liệu số", "fa-photo-film"),
        (SiteMap.Map, "Bản đồ số", "fa-map-location-dot"),
    };
    string? ShortcutUrl(string urlName) => urlName == SiteMap.Periods ? home.LibraryRoot()?.Url() : home.Section(urlName)?.Url();
}
<aside class="side-col">
    <nav class="side-shortcuts" aria-label="@SiteHelpers.T("Lối tắt")">
        @foreach (var (urlName, label, icon) in shortcuts)
        {
            if (ShortcutUrl(urlName) is string url) { <a href="@url"><i class="fa @icon"></i> @SiteHelpers.T(label)</a> }
        }
    </nav>
    @foreach (var (block, count, icon) in blocks)
    {
        if (block == null) { continue; }
        var items = block.Items(count).ToList();
        if (!items.Any()) { continue; }
        <section class="side-block">
            <h2 class="sec-title line"><a href="@block.Url()">@block.Name @SiteHelpers.CountBadge(block.ItemCount())</a></h2>
            @foreach (var x in items)
            {
                <article class="side-item">
                    <a class="side-thumb" href="@x.Url()">
                        @if (x.ContentImage(192, 128, usedImages) is string img) { <img src="@img" alt="@x.Name" loading="lazy" /> } else { <span class="noimg"><i class="fa @icon"></i></span> }
                        <span class="side-ico"><i class="fa @icon"></i></span>
                    </a>
                    <h3><a href="@x.Url()">@x.Name</a></h3>
                </article>
            }
            <a class="side-more" href="@block.Url()">@SiteHelpers.T("Xem tất cả") <i class="fa fa-angle-right"></i></a>
        </section>
    }
</aside>
