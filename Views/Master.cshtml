@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;
    var home = Model.Root();
    var siteName = home.Value<string>(Props.SiteName) ?? home.Name;
    var slogan = home.Value<string>(Props.Slogan);
    var logo = home.Img(200, 200, "logo");
    var banner = home.Value<IPublishedContent>("bannerImage")?.Url();
    var bannerMobile = home.Value<IPublishedContent>("bannerMobile")?.Url() ?? banner;
    var searchPage = home.Children().FirstOrDefault(x => x.ContentType.Alias == "searchPage");
    var title = Model.Id == home.Id ? siteName : $"{Model.Name} - {siteName}";
    var links = (home.Value<string>("websiteLinks") ?? "")
        .Split('\n', StringSplitOptions.RemoveEmptyEntries)
        .Select(l => l.Split('|')).Where(p => p.Length == 2);
    var pages = home.Children().Where(x => x.ContentType.Alias is "textPage" or "sitemapPage").ToList();
}
<!doctype html>
<html lang="@SiteHelpers.HtmlLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Dancing+Script:wght@700&family=Noto+Serif:wght@700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox@3.3.0/dist/css/glightbox.min.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/library.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/library-extra.css" asp-append-version="true" />
    <script>(function(){var t;try{t=localStorage.getItem("@Theme.StorageKey")}catch(e){}if(!t)t=matchMedia("(prefers-color-scheme: dark)").matches?"@Theme.Dark":"@Theme.Light";document.documentElement.dataset.theme=t})()</script>
    <script>(function(){var d=document.documentElement;try{var z=parseInt(localStorage.getItem("@Accessibility.ZoomKey"),10);if(z>=@Accessibility.MinZoom&&z<=@Accessibility.MaxZoom)d.style.setProperty("--a11y-zoom",z/100)}catch(e){}})()</script>
</head>
<body>
<div class="a11y-page">
<header class="site-header">
    <a class="banner" href="@home.Url()">
        @if (banner != null)
        {
            <picture>
                <source media="(max-width: 767px)" srcset="@bannerMobile" />
                <img src="@banner" alt="@siteName" />
            </picture>
        }
        else
        {
            <div class="banner-default">
                <div class="banner-left">
                    @if (logo != null) { <img class="logo" src="@logo" alt="" /> }
                    else { <span class="emblem"><i class="fa fa-star"></i></span> }
                </div>
                <div class="banner-center">
                    <span class="site-name">@siteName</span>
                    @if (!string.IsNullOrEmpty(slogan)) { <span class="slogan">@slogan</span> }
                </div>
                <div class="banner-right" aria-hidden="true"></div>
            </div>
        }
    </a>
    <nav class="mainnav">
        <div class="container nav-inner">
            <ul class="menu">
                <li class="home-ico @(Model.Id == home.Id ? "active" : "")"><a href="@home.Url()" aria-label="@SiteHelpers.T("Trang chủ")"><i class="fa fa-house"></i></a></li>
                @foreach (var item in home.MenuChildren())
                {
                    var subs = item.MenuChildren().ToList();
                    var active = Model.Path.Split(',').Contains(item.Id.ToString());
                    <li class="@(active ? "active" : "") @(subs.Any() ? "has-sub" : "")">
                        <a href="@item.Url()">@item.Name <span class="menu-count">(@item.ItemCount())</span></a>
                        @if (subs.Any())
                        {
                            <ul class="sub">
                                @foreach (var sub in subs)
                                {
                                    var subs2 = sub.MenuChildren().ToList();
                                    <li class="@(subs2.Any() ? "has-sub" : "")">
                                        <a href="@sub.Url()">@sub.Name <span class="menu-count">(@sub.ItemCount())</span></a>
                                        @if (subs2.Any())
                                        {
                                            <ul class="sub sub2">
                                                @foreach (var s2 in subs2) { <li><a href="@s2.Url()">@s2.Name <span class="menu-count">(@s2.ItemCount())</span></a></li> }
                                            </ul>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
            <div class="nav-tools">
                <button class="nav-btn" aria-label="Menu" onclick="document.body.classList.toggle('nav-open')"><i class="fa fa-bars"></i></button>
                @* Tạm ẩn nút đổi ngôn ngữ cho tới khi bản tiếng Anh có đủ nội dung
                <a class="nav-btn lang-btn" href="@Model.SwitchLanguageUrl(home)" hreflang="@SiteHelpers.OtherCulture" title="@SiteHelpers.T("Chuyển sang tiếng Anh")">@SiteHelpers.OtherLabel</a>
                *@
                <button class="nav-btn theme-btn" type="button" data-storage-key="@Theme.StorageKey" data-dark="@Theme.Dark" data-light="@Theme.Light" aria-label="@SiteHelpers.T("Chế độ sáng/tối")" title="@SiteHelpers.T("Chế độ sáng/tối")"><i class="fa fa-moon"></i><i class="fa fa-sun"></i></button>
                <button class="nav-btn search-btn" aria-label="@SiteHelpers.T("Tìm kiếm")" onclick="document.body.classList.toggle('search-open');document.querySelector('.search-drop input').focus()"><i class="fa fa-search"></i></button>
            </div>
        </div>
        <form class="search-drop" action="@(searchPage?.Url() ?? "/")" method="get">
            <div class="container">
                <input type="search" name="q" placeholder="@SiteHelpers.T("Nhập từ khóa tìm kiếm (có dấu hoặc không dấu)...")" aria-label="@SiteHelpers.T("Tìm kiếm")" />
                <button type="submit">@SiteHelpers.T("Tìm kiếm")</button>
            </div>
        </form>
    </nav>
</header>

<div class="container datebar">
    <div class="date-box"><i class="fa-regular fa-calendar"></i> <span id="clock" data-days='@System.Text.Json.JsonSerializer.Serialize(SiteHelpers.IsEn ? UiText.EnDays : UiText.ViDays)'></span></div>
    <div class="ticker">
        <div class="ticker-move">
            @foreach (var t in home.Items(10).ToList() is var tk ? tk.Concat(tk) : null!) { <a href="@t.Url()"><i class="fa fa-star"></i> @t.Name</a> }
        </div>
    </div>
</div>

<main class="site-main">
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container">
        <div class="footer-top">
            <p class="org">@home.Value("footerOrg")</p>
            @if (links.Any())
            {
                <label class="footer-links">
                    <span>@SiteHelpers.T("Liên kết website")</span>
                    <select onchange="if(this.value) window.open(this.value, '_blank')">
                        <option value="">@SiteHelpers.T("-- Chọn liên kết --")</option>
                        @foreach (var l in links) { <option value="@l[1].Trim()">@l[0].Trim()</option> }
                    </select>
                </label>
            }
        </div>
        <div class="footer-info">
            <p><i class="fa fa-copyright"></i> @home.Value("footerCopyright")</p>
            <p><i class="fa fa-location-dot"></i> <b>@SiteHelpers.T("Địa chỉ"):</b> @home.Value("footerAddress")</p>
            @if (home.HasValue("footerEmail"))
            {
                <p><i class="fa fa-envelope"></i> <b>Email:</b> <a href="mailto:@home.Value("footerEmail")">@home.Value("footerEmail")</a></p>
            }
        </div>
        @if (pages.Any())
        {
            <div class="footer-pages">
                @foreach (var p in pages) { <a href="@p.Url()">@p.Name</a> }
            </div>
        }
    </div>
</footer>
</div>
<div class="a11y-fab" role="group" aria-label="@SiteHelpers.T("Cỡ chữ")"
     data-zoom-key="@Accessibility.ZoomKey" data-min="@Accessibility.MinZoom" data-max="@Accessibility.MaxZoom" data-step="@Accessibility.ZoomStep">
    <div class="a11y-panel">
        <span class="a11y-title"><i class="fa fa-text-height"></i> @SiteHelpers.T("Cỡ chữ")</span>
        <button type="button" data-a11y="zoom-in" title="@SiteHelpers.T("Tăng cỡ chữ")" aria-label="@SiteHelpers.T("Tăng cỡ chữ")">A<sup>+</sup></button>
        <span class="a11y-zoom" aria-live="polite">100%</span>
        <button type="button" data-a11y="zoom-out" title="@SiteHelpers.T("Giảm cỡ chữ")" aria-label="@SiteHelpers.T("Giảm cỡ chữ")">A<sup>−</sup></button>
        <button type="button" data-a11y="zoom-reset" class="reset" title="@SiteHelpers.T("Cỡ chữ mặc định")" aria-label="@SiteHelpers.T("Cỡ chữ mặc định")"><i class="fa fa-rotate-left"></i></button>
    </div>
</div>
<a href="#" class="to-top" aria-label="@SiteHelpers.T("Lên đầu trang")"><i class="fa fa-arrow-up"></i></a>

<script src="https://cdn.jsdelivr.net/npm/glightbox@3.3.0/dist/js/glightbox.min.js"></script>
@if (Model.ContentType.Alias == DocTypes.PdfDocument)
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.js"></script>
}
<script src="/js/site.js" asp-append-version="true"></script>
</body>
</html>
