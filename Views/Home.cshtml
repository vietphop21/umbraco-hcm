@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@*
    Trang chủ giữ đúng 04 khối theo Đề xuất site map: Banner & giới thiệu, Ô tìm kiếm nhanh,
    Lối tắt 11 chuyên mục, Tin tức – sự kiện – lịch hoạt động. Không thêm khối khác.
*@
@{
    Layout = "Master.cshtml";
    const int NewsCount = 5;

    var home = Model;
    var news = home.Section(SiteMap.News) ?? home.Children().FirstOrDefault(c => c.Name == "Tin tức");
    var newsItems = news.Items(NewsCount).ToList();
    var searchUrl = home.Section(SiteMap.Search)?.Url()
                    ?? home.Children().FirstOrDefault(x => x.ContentType.Alias == DocTypes.SearchPage)?.Url() ?? "/";
    var siteName = home.Value<string>(Props.SiteName) ?? home.Name;
    var intro = home.Section(SiteMap.Intro);
    // Ảnh bìa thẻ lấy từ tư liệu của chính chuyên mục và phải cùng chủ đề với tên chuyên mục; không có thì dùng nền trung tính.
    var usedCovers = new HashSet<string>();
    string? PickCover(IPublishedContent section)
    {
        var own = section.Items()
            .Where(x => x.ImgKey() != null && HcmPortal.Setup.ImageRelevance.Fits(section.Name, x.Value<IPublishedContent>(LibraryProps.Thumbnail)?.Name))
            .ToList();
        var pick = own.Where(x => x.HasLandscapeImage()).FirstOrDefault(x => !usedCovers.Contains(x.ImgKey()!))
                   ?? own.FirstOrDefault(x => !usedCovers.Contains(x.ImgKey()!))
                   ?? own.FirstOrDefault();
        if (pick?.ImgKey() is { } key) usedCovers.Add(key);
        if (pick?.Img(640, 480) is { } image) return image;

        var sectionUrl = section.Value<string>(SiteMap.UrlNameProp, Cultures.Vi);
        return sectionUrl switch
        {
            SiteMap.Intro => "/media/eiqnfkok/hanoi-vietnam-interiors-of-ho-chi-minh-museum.jpg",
            SiteMap.Life => "/media/j3jnagiz/ho-chi-minh-1946.jpg",
            SiteMap.Thought => "/media/0yjf02uo/ho-chi-minh-museum-hanoi-2.jpg",
            SiteMap.Saigon => "/media/zmbjlwqb/h%E1%BB%8Dc-vi%C3%AAn-an-ninh-tham-quan-b%E1%BA%BFn-nh%C3%A0-r%E1%BB%93ng.jpg",
            SiteMap.Works => "/media/ahahdmp1/hanoi-vietnam-ho-chi-minh-museum-02.jpg",
            SiteMap.Kids => "/media/3dhkhyrz/%C4%91%C3%B4i-d%C3%A9p-b%C3%A1c-h%E1%BB%93-t%E1%BA%A1i-b%E1%BA%A3o-t%C3%A0ng-b%E1%BA%BFn-nh%C3%A0-r%E1%BB%93ng-n%C4%83m-2018-2.jpg",
            SiteMap.Follow => "/media/i55mnvfw/honour-guards-at-ho-chi-minh-mausoleum-hanoi-20240123-1133-3240.jpg",
            SiteMap.Sectors => "/media/d3njnpcd/hanoi-vietnam-visitors-at-ho-chi-minh-museum.jpg",
            SiteMap.Documents => "/media/ffoml1n5/ba-dinh-square-september-2nd-1945.jpg",
            SiteMap.Media => "/media/dc4dkpna/oct2025visit-to-the-ho-chi-minh-museum-hanoi-vietnam-03.jpg",
            SiteMap.Map => "/media/o3earjbj/kim-lien-monuments-park.jpg",
            _ => null,
        };
    }
}

<section class="hero">
    <div class="container hero-inner">
        <h1>@siteName</h1>
        <p>@SiteHelpers.T("Tra cứu sách, tài liệu, hình ảnh, phim và sách nói về cuộc đời, sự nghiệp, tư tưởng, đạo đức, phong cách Chủ tịch Hồ Chí Minh")</p>
        <form class="hero-search" action="@searchUrl" method="get" role="search">
            <input type="search" name="@LibraryQueryKeys.Keyword" placeholder="@SiteHelpers.T("Nhập từ khóa (có dấu hoặc không dấu)...")" aria-label="@SiteHelpers.T("Tìm kiếm")" />
            <select name="@LibraryQueryKeys.Type" aria-label="@SiteHelpers.T("Loại tư liệu")">
                <option value="">@SiteHelpers.T("Tất cả loại")</option>
                @foreach (var t in LibraryQuery.Types) { <option value="@t.Alias">@SiteHelpers.T(t.Label)</option> }
            </select>
            <button type="submit"><i class="fa fa-magnifying-glass"></i> @SiteHelpers.T("Tìm kiếm")</button>
        </form>
        @if (intro != null) { <a class="hero-more" href="@intro.Url()">@SiteHelpers.T("Giới thiệu Không gian Văn hóa Hồ Chí Minh") <i class="fa fa-arrow-right"></i></a> }
    </div>
</section>

<div class="container">
    <section class="sec">
        <h2 class="sec-title line">@SiteHelpers.T("Chuyên mục")</h2>
        <div class="section-grid">
            @foreach (var (info, node) in home.Sections())
            {
                var cover = PickCover(node);
                <a class="section-card" href="@node.Url()">
                    <span class="sc-cover">
                        @if (cover != null) { <img src="@cover" alt="" loading="lazy" /> } else { <span class="noimg"><i class="fa @info.Icon"></i></span> }
                        <span class="sc-code">@info.Code</span>
                    </span>
                    <span class="sc-body">
                        <strong class="sc-name">@node.Name</strong>
                        <span class="sc-desc">@info.Description</span>
                        @if (node.ContentType.Alias == DocTypes.TextPage) { <span class="sc-count sc-more">@SiteHelpers.T("Xem giới thiệu") <i class="fa fa-arrow-right"></i></span> }
                        else { <span class="sc-count"><i class="fa fa-layer-group"></i> @node.ItemCount() @SiteHelpers.T("tư liệu")</span> }
                    </span>
                </a>
            }
        </div>
    </section>

    @if (newsItems.Any())
    {
        <section class="sec">
            <h2 class="sec-title line"><a href="@news!.Url()">@SiteHelpers.T("Tin tức – Sự kiện – Lịch hoạt động") @SiteHelpers.CountBadge(news.ItemCount())</a></h2>
            <div class="news-grid">
                @{ var f = newsItems[0]; }
                @{ var fi = f.Img(760, 480); }
                <article class="news-big@(fi == null ? " no-thumb" : "")">
                    @if (fi != null) { <a class="thumb" href="@f.Url()"><img src="@fi" alt="@f.Name" loading="lazy" /></a> }
                    <h3><a href="@f.Url()">@f.Name</a></h3>
                    <p class="sapo">@f.Value(Props.Summary)</p>
                    <time>@f.Date().ToString("dd/MM/yyyy")</time>
                </article>
                <div class="news-list">
                    @foreach (var x in newsItems.Skip(1))
                    {
                        <article>
                            <h3><a href="@x.Url()">@x.Name</a></h3>
                            <p class="sapo">@x.Value(Props.Summary)</p>
                            <time>@x.Date().ToString("dd/MM/yyyy")</time>
                        </article>
                    }
                </div>
            </div>
            <a class="sec-more" href="@news!.Url()">@SiteHelpers.T("Xem tất cả tin tức") <i class="fa fa-arrow-right"></i></a>
        </section>
    }
</div>
