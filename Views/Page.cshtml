@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using HcmPortal.Controllers
@{
    Layout = "Master.cshtml";
    var latest = Model.Root().Items(8).ToList();
}
<div class="container page-wrap">
    <div class="two-col">
        <article class="detail">
            <h1 class="sec-title line">@Model.Name</h1>
            <div class="detail-body">@Model.Value("bodyText")</div>

            @{
                var explore = Model.Root().Sections().Where(s => s.Node.Id != Model.Id)
                    .OrderBy(s => s.Info.UrlName == SiteMap.Life ? 0 : s.Info.UrlName == SiteMap.Thought ? 1 : s.Info.UrlName == SiteMap.Media ? 2 : 3)
                    .Take(4).ToList();
                var usedImages = new HashSet<string>();
                ViewData["UsedContentImages"] = usedImages;
            }
            @if (explore.Any())
            {
                <section class="page-explore" aria-labelledby="page-explore-title">
                    <h2 id="page-explore-title" class="sec-title line">@SiteHelpers.T("Khám phá nội dung")</h2>
                    <div class="page-explore-grid">
                        @foreach (var (info, node) in explore)
                        {
                            var image = node.ContentImage(480, 280, usedImages);
                            <a href="@node.Url()">
                                @if (image != null) { <img src="@image" alt="" loading="lazy" /> }
                                <span class="page-explore-copy"><small class="page-explore-code">@info.Code</small><strong>@SiteHelpers.T(info.MenuName)</strong><small>@SiteHelpers.T(info.Description)</small></span>
                            </a>
                        }
                    </div>
                </section>
            }

            @if (Model.Value<bool>("showContactForm"))
            {
                if (TempData["contactOk"] != null)
                {
                    <div class="alert ok"><i class="fa fa-circle-check"></i> @SiteHelpers.T("Cảm ơn bạn! Thư đã được gửi tới ban biên tập.")</div>
                }
                else
                {
                    if (TempData["contactError"] is string err) { <div class="alert err">@err</div> }
                    using (Html.BeginUmbracoForm<ContactController>(nameof(ContactController.Submit), null, new { @class = "contact-form" }))
                    {
                        <div class="row2">
                            <label>@SiteHelpers.T("Họ và tên *")<input name="Name" required maxlength="100" /></label>
                            <label>Email *<input name="Email" type="email" required maxlength="100" /></label>
                        </div>
                        <label>@SiteHelpers.T("Số điện thoại")<input name="Phone" maxlength="20" /></label>
                        <label>@SiteHelpers.T("Nội dung *")<textarea name="Message" rows="6" required maxlength="4000"></textarea></label>
                        <button type="submit"><i class="fa fa-paper-plane"></i> @SiteHelpers.T("Gửi liên hệ")</button>
                    }
                }
            }
        </article>
        <partial name="Site/Sidebar" />
    </div>
</div>
<partial name="Site/OtherSections" />
