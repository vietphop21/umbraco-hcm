    <NodeName Default="Tóm tắt tiểu sử Chủ tịch Hồ Chí Minh">
      <Name Culture="en-us">Brief Biography of President Ho Chi Minh</Name>
      <Name Culture="vi-vn">Tóm tắt tiểu sử Chủ tịch Hồ Chí Minh</Name>
    </NodeName>
    <SortOrder>0</SortOrder>
