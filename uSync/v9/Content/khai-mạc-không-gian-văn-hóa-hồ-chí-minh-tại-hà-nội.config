    <NodeName Default="Khai mạc không gian văn hóa Hồ Chí Minh tại Hà Nội">
      <Name Culture="en-us">Opening of the Ho Chi Minh Cultural Space in Hanoi</Name>
      <Name Culture="vi-vn">Khai mạc không gian văn hóa Hồ Chí Minh tại Hà Nội</Name>
    </NodeName>
    <SortOrder>12</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
