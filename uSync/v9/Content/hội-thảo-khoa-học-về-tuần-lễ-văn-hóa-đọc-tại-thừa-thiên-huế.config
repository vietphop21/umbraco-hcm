    <NodeName Default="Hội thảo khoa học về tuần lễ văn hóa đọc tại Thừa Thiên Huế">
      <Name Culture="en-us">Scientific Conference on Reading Culture Week in Thua Thien Hue</Name>
      <Name Culture="vi-vn">Hội thảo khoa học về tuần lễ văn hóa đọc tại Thừa Thiên Huế</Name>
    </NodeName>
