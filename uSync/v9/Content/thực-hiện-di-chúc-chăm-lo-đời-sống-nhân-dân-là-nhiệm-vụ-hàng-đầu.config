    <NodeName Default="Thực hiện Di chúc: Chăm lo đời sống nhân dân là nhiệm vụ hàng đầu">
      <Name Culture="en-us">Implementing the Testament: Caring for the People's Lives Is the Foremost Task</Name>
      <Name Culture="vi-vn">Thực hiện Di chúc: Chăm lo đời sống nhân dân là nhiệm vụ hàng đầu</Name>
    </NodeName>
    <SortOrder>1</SortOrder>
    <Published Default="true">
