    <NodeName Default="Những con đường mang tên Hồ Chí Minh trên khắp năm châu">
      <Name Culture="en-us">Streets Named after Ho Chi Minh across the Five Continents</Name>
      <Name Culture="vi-vn">Những con đường mang tên Hồ Chí Minh trên khắp năm châu</Name>
    </NodeName>
