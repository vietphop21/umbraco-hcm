    <NodeName Default="Vận dụng tư tưởng vì dân trong công tác cán bộ">
      <Name Culture="en-us">Applying the People-Centred Philosophy in Cadre Work</Name>
      <Name Culture="vi-vn">Vận dụng tư tưởng vì dân trong công tác cán bộ</Name>
    </NodeName>
    <SortOrder>19</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
