    <NodeName Default="Những bài học về đoàn kết rút ra từ bản Di chúc lịch sử">
      <Name Culture="en-us">Lessons on Unity Drawn from the Historic Testament</Name>
      <Name Culture="vi-vn">Những bài học về đoàn kết rút ra từ bản Di chúc lịch sử</Name>
    </NodeName>
    <SortOrder>2</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
