    <NodeName Default="Lối sống giản dị, khiêm tốn – bài học cho thế hệ hôm nay">
      <Name Culture="en-us">A Simple and Modest Lifestyle – A Lesson for Today's Generation</Name>
      <Name Culture="vi-vn">Lối sống giản dị, khiêm tốn – bài học cho thế hệ hôm nay</Name>
    </NodeName>
    <SortOrder>4</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
