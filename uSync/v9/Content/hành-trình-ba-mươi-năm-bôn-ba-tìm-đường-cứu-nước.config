    <NodeName Default="Hành trình ba mươi năm bôn ba tìm đường cứu nước">
      <Name Culture="en-us">Thirty Years of Wandering in Search of a Path to National Salvation</Name>
      <Name Culture="vi-vn">Hành trình ba mươi năm bôn ba tìm đường cứu nước</Name>
    </NodeName>
    <SortOrder>2</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
