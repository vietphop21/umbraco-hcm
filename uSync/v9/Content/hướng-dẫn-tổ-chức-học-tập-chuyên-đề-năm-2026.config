    <NodeName Default="Hướng dẫn tổ chức học tập chuyên đề năm 2026">
      <Name Culture="en-us">Guidelines for Organising the 2026 Thematic Study</Name>
      <Name Culture="vi-vn">Hướng dẫn tổ chức học tập chuyên đề năm 2026</Name>
    </NodeName>
