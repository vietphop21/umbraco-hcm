    <NodeName Default="Trách nhiệm nêu gương – từ lý luận đến thực tiễn">
      <Name Culture="en-us">The Responsibility to Set an Example – From Theory to Practice</Name>
      <Name Culture="vi-vn">Trách nhiệm nêu gương – từ lý luận đến thực tiễn</Name>
    </NodeName>
    <SortOrder>20</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
