    <NodeName Default="Tư tưởng Hồ Chí Minh về xây dựng chính quyền gần dân, vì dân">
      <Name Culture="en-us">Ho Chi Minh's Thought on Building a Government Close to the People and for the People</Name>
      <Name Culture="vi-vn">Tư tưởng Hồ Chí Minh về xây dựng chính quyền gần dân, vì dân</Name>
    </NodeName>
    <SortOrder>2</SortOrder>
    <Published Default="true">
