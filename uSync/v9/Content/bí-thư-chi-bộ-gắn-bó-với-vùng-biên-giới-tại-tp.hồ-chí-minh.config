    <NodeName Default="Bí thư chi bộ gắn bó với vùng biên giới tại TP. Hồ Chí Minh">
      <Name Culture="en-us">Party Cell Secretary Devoted to the Border Area in Ho Chi Minh City</Name>
      <Name Culture="vi-vn">Bí thư chi bộ gắn bó với vùng biên giới tại TP. Hồ Chí Minh</Name>
    </NodeName>
