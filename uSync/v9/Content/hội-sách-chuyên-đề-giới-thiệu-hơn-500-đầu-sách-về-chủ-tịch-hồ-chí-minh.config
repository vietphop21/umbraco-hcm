    <NodeName Default="Hội sách chuyên đề giới thiệu hơn 500 đầu sách về Chủ tịch Hồ Chí Minh">
      <Name Culture="en-us">Thematic Book Fair Presents More Than 500 Titles on President Ho Chi Minh</Name>
      <Name Culture="vi-vn">Hội sách chuyên đề giới thiệu hơn 500 đầu sách về Chủ tịch Hồ Chí Minh</Name>
    </NodeName>
    <SortOrder>8</SortOrder>
    <Published Default="true">
