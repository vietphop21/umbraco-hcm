    <NodeName Default="Tổ chức chương trình “Theo dấu chân Bác” tại Nghệ An">
      <Name Culture="en-us">Organising the “Following Uncle Ho's Footsteps” Programme in Nghe An</Name>
      <Name Culture="vi-vn">Tổ chức chương trình “Theo dấu chân Bác” tại Nghệ An</Name>
    </NodeName>
    <SortOrder>37</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
