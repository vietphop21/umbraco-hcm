<Content Key="591d5a4d-9295-4260-8d73-ecbd8731dbba" Alias="Tượng đài, công trình tưởng niệm tại nhiều nước trên thế giới" Level="4">
  <Info>
    <Parent Key="7094342f-248e-4814-b944-047f5e8b6381">Bạn bè quốc tế</Parent>
