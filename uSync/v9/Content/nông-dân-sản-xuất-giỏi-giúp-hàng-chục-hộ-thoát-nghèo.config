    <NodeName Default="Nông dân sản xuất giỏi giúp hàng chục hộ thoát nghèo">
      <Name Culture="en-us">Model Farmer Helps Dozens of Households Escape Poverty</Name>
      <Name Culture="vi-vn">Nông dân sản xuất giỏi giúp hàng chục hộ thoát nghèo</Name>
    </NodeName>
    <SortOrder>4</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
