<Content Key="79bdbd37-5274-4c66-ae85-9f800488411a" Alias="Hội thảo quốc tế về di sản văn hóa của danh nhân Việt Nam" Level="4">
  <Info>
    <Parent Key="f54f72dc-3dee-449b-9a62-274ac9bff21c">Hoạt động quốc tế</Parent>
