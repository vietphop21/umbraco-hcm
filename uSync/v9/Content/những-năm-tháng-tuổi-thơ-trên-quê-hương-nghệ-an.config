      <Name Culture="en-us">Childhood Years in His Homeland of Nghe An</Name>
      <Name Culture="vi-vn">Những năm tháng tuổi thơ trên quê hương Nghệ An</Name>
    </NodeName>
    <SortOrder>1</SortOrder>
