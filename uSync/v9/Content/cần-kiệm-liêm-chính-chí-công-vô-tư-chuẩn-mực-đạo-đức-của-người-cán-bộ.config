    <NodeName Default="Cần, kiệm, liêm, chính, chí công vô tư – chuẩn mực đạo đức của người cán bộ">
      <Name Culture="en-us">Diligence, Thrift, Integrity, Righteousness, Impartiality and Selflessness – The Ethical Standards of a Cadre</Name>
      <Name Culture="vi-vn">Cần, kiệm, liêm, chính, chí công vô tư – chuẩn mực đạo đức của người cán bộ</Name>
    </NodeName>
    <SortOrder>1</SortOrder>
