<Content Key="8b22af53-f344-40c1-98cd-1b1eff9adabb" Alias="Cần, kiệm, liêm, chính, chí công vô tư – chuẩn mực đạo đức của người cán bộ" Level="4">
  <Info>
    <Parent Key="6cef87da-59ed-45a4-8db8-7d16a045b3ec">Nội dung tư tưởng đạo đức</Parent>
    <Path>/TrangChu/TuTuongDaoDucPhongCachHoChiMinh/NoiDungTuTuongDaoDuc/CanKiemLiemChinhChiCongVoTuChuanMucDaoDucCuaNguoiCanBo</Path>
