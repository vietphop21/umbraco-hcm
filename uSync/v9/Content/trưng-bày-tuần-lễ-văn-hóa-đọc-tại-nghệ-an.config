    <NodeName Default="Trưng bày tuần lễ văn hóa đọc tại Nghệ An">
      <Name Culture="en-us">Reading Culture Week Exhibition in Nghe An</Name>
      <Name Culture="vi-vn">Trưng bày tuần lễ văn hóa đọc tại Nghệ An</Name>
    </NodeName>
    <SortOrder>25</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
