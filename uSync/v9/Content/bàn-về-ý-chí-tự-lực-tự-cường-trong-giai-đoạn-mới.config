    <NodeName Default="Bàn về ý chí tự lực tự cường trong giai đoạn mới">
      <Name Culture="en-us">On the Will for Self-Reliance and Self-Strengthening in the New Period</Name>
      <Name Culture="vi-vn">Bàn về ý chí tự lực tự cường trong giai đoạn mới</Name>
    </NodeName>
    <SortOrder>6</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
