    <NodeName Default="Phong cách quần chúng – từ lý luận đến thực tiễn">
      <Name Culture="en-us">The Mass-Oriented Style – from Theory to Practice</Name>
      <Name Culture="vi-vn">Phong cách quần chúng – từ lý luận đến thực tiễn</Name>
    </NodeName>
    <SortOrder>17</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
