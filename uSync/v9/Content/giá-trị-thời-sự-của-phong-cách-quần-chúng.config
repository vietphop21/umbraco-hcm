    <NodeName Default="Giá trị thời sự của phong cách quần chúng">
      <Name Culture="en-us">The Contemporary Relevance of the Mass-Oriented Style</Name>
      <Name Culture="vi-vn">Giá trị thời sự của phong cách quần chúng</Name>
    </NodeName>
    <SortOrder>7</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
