    <NodeName Default="Nữ công an xã giữ gìn nét đẹp văn hóa truyền thống tại Thái Nguyên">
      <Name Culture="en-us">Female Commune Police Officer Preserves Traditional Culture in Thai Nguyen</Name>
      <Name Culture="vi-vn">Nữ công an xã giữ gìn nét đẹp văn hóa truyền thống tại Thái Nguyên</Name>
    </NodeName>
    <SortOrder>26</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
