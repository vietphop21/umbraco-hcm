    <NodeName Default="Vận dụng tinh thần đoàn kết trong công tác cán bộ">
      <Name Culture="en-us">Applying the Spirit of Solidarity in Cadre Work</Name>
      <Name Culture="vi-vn">Vận dụng tinh thần đoàn kết trong công tác cán bộ</Name>
    </NodeName>
    <SortOrder>16</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
