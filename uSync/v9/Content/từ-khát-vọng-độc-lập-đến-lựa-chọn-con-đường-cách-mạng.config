    <NodeName Default="Từ khát vọng độc lập đến lựa chọn con đường cách mạng">
      <Name Culture="en-us">From the Aspiration for Independence to the Choice of the Revolutionary Path</Name>
      <Name Culture="vi-vn">Từ khát vọng độc lập đến lựa chọn con đường cách mạng</Name>
    </NodeName>
    <SortOrder>3</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
    </Published>
