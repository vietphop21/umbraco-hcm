    <NodeName Default="Người thầy tận tụy với bà con vùng khó tại Hà Nội">
      <Name Culture="en-us">A Teacher Devoted to People in Disadvantaged Areas of Hanoi</Name>
      <Name Culture="vi-vn">Người thầy tận tụy với bà con vùng khó tại Hà Nội</Name>
    </NodeName>
    <SortOrder>10</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
