    <NodeName Default="Ý chí tự lực tự cường – từ lý luận đến thực tiễn">
      <Name Culture="en-us">The Will of Self-Reliance and Self-Strengthening – From Theory to Practice</Name>
      <Name Culture="vi-vn">Ý chí tự lực tự cường – từ lý luận đến thực tiễn</Name>
    </NodeName>
    <SortOrder>22</SortOrder>
    <Published Default="true">
