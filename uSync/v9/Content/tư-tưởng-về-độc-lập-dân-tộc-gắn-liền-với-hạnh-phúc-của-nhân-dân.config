<Content Key="c4bfe02d-9a0b-4a00-b32d-e7164ee407ce" Alias="Tư tưởng về độc lập dân tộc gắn liền với hạnh phúc của nhân dân" Level="4">
  <Info>
    <Parent Key="6cef87da-59ed-45a4-8db8-7d16a045b3ec">Nội dung tư tưởng đạo đức</Parent>
