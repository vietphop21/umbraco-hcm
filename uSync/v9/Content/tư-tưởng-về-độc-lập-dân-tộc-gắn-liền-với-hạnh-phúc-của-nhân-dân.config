    <NodeName Default="Tư tưởng về độc lập dân tộc gắn liền với hạnh phúc của nhân dân">
      <Name Culture="en-us">The Thought on National Independence Linked with the Happiness of the People</Name>
      <Name Culture="vi-vn">Tư tưởng về độc lập dân tộc gắn liền với hạnh phúc của nhân dân</Name>
    </NodeName>
    <SortOrder>0</SortOrder>
