    <NodeName Default="Vận dụng phong cách quần chúng trong công tác cán bộ">
      <Name Culture="en-us">Applying the Mass-Oriented Style in Cadre Work</Name>
      <Name Culture="vi-vn">Vận dụng phong cách quần chúng trong công tác cán bộ</Name>
    </NodeName>
    <SortOrder>15</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
