    <NodeName Default="Phố đi bộ tổ chức triển lãm ảnh ngoài trời về Bác Hồ với thiếu nhi">
      <Name Culture="en-us">Pedestrian Street Hosts Outdoor Photo Exhibition on Uncle Ho and Children</Name>
      <Name Culture="vi-vn">Phố đi bộ tổ chức triển lãm ảnh ngoài trời về Bác Hồ với thiếu nhi</Name>
    </NodeName>
    <SortOrder>7</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
    </Published>
