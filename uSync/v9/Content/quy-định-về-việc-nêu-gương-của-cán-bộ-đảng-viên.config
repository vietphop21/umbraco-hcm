    <NodeName Default="Quy định về việc nêu gương của cán bộ, đảng viên">
      <Name Culture="en-us">Regulations on Setting an Example by Cadres and Party Members</Name>
      <Name Culture="vi-vn">Quy định về việc nêu gương của cán bộ, đảng viên</Name>
    </NodeName>
