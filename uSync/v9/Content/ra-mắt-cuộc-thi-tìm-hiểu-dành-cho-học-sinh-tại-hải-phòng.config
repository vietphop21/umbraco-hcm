    <NodeName Default="Ra mắt cuộc thi tìm hiểu dành cho học sinh tại Hải Phòng">
      <Name Culture="en-us">Launch of a Knowledge Contest for Pupils in Hai Phong</Name>
      <Name Culture="vi-vn">Ra mắt cuộc thi tìm hiểu dành cho học sinh tại Hải Phòng</Name>
    </NodeName>
    <SortOrder>22</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
