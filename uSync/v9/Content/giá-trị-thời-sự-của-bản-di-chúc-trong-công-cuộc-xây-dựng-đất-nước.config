    <NodeName Default="Giá trị thời sự của bản Di chúc trong công cuộc xây dựng đất nước">
      <Name Culture="en-us">The Contemporary Relevance of the Testament in Building the Country</Name>
      <Name Culture="vi-vn">Giá trị thời sự của bản Di chúc trong công cuộc xây dựng đất nước</Name>
    </NodeName>
    <SortOrder>0</SortOrder>
