    <NodeName Default="Kế hoạch tuyên truyền kỷ niệm các ngày lễ lớn trong năm">
      <Name Culture="en-us">Communication Plan for Commemorating the Major Holidays of the Year</Name>
      <Name Culture="vi-vn">Kế hoạch tuyên truyền kỷ niệm các ngày lễ lớn trong năm</Name>
    </NodeName>
