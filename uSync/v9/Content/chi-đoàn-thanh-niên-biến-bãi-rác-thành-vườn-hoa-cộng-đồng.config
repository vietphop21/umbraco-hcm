    <NodeName Default="Chi đoàn thanh niên biến bãi rác thành vườn hoa cộng đồng">
      <Name Culture="en-us">Youth Union Branch Turns a Rubbish Dump into a Community Flower Garden</Name>
      <Name Culture="vi-vn">Chi đoàn thanh niên biến bãi rác thành vườn hoa cộng đồng</Name>
    </NodeName>
    <SortOrder>3</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
