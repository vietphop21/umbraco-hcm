    <NodeName Default="Ra mắt chương trình “Theo dấu chân Bác” tại Thừa Thiên Huế">
      <Name Culture="en-us">Launch of the “Following Uncle Ho's Footsteps” Programme in Thua Thien Hue</Name>
      <Name Culture="vi-vn">Ra mắt chương trình “Theo dấu chân Bác” tại Thừa Thiên Huế</Name>
    </NodeName>
    <SortOrder>30</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
