<Content Key="033d5e0d-962b-430c-aba8-5dd40f180bcc" Alias="Kiều bào tổ chức chương trình hướng về Tổ quốc tại Mông Cổ" Level="4">
  <Info>
    <Parent Key="f54f72dc-3dee-449b-9a62-274ac9bff21c">Hoạt động quốc tế</Parent>
    <Path>/TrangChu/HoChiMinhVaTheGioi/HoatDongQuocTe/KieuBaoToChucChuongTrinhHuongVeToQuocTaiMongCo</Path>
