    <NodeName Default="Bạn bè quốc tế viết về vị lãnh tụ của nhân dân Việt Nam">
      <Name Culture="en-us">International Friends Write about the Leader of the Vietnamese People</Name>
      <Name Culture="vi-vn">Bạn bè quốc tế viết về vị lãnh tụ của nhân dân Việt Nam</Name>
    </NodeName>
    <SortOrder>0</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
