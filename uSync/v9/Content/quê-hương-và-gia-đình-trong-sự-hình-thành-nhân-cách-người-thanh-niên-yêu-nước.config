    <NodeName Default="Quê hương và gia đình trong sự hình thành nhân cách người thanh niên yêu nước">
      <Name Culture="en-us">Homeland and Family in the Shaping of a Young Patriot's Character</Name>
      <Name Culture="vi-vn">Quê hương và gia đình trong sự hình thành nhân cách người thanh niên yêu nước</Name>
    </NodeName>
    <SortOrder>2</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
