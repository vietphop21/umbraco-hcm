    <NodeName Default="Phim hoạt hình thiếu nhi: Bác Hồ với các cháu">
      <Name Culture="en-us">Children's Animated Film: Uncle Ho and the Children</Name>
      <Name Culture="vi-vn">Phim hoạt hình thiếu nhi: Bác Hồ với các cháu</Name>
    </NodeName>
