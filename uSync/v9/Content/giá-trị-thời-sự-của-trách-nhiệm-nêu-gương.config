    <NodeName Default="Giá trị thời sự của trách nhiệm nêu gương">
      <Name Culture="en-us">The Contemporary Relevance of the Responsibility to Set an Example</Name>
      <Name Culture="vi-vn">Giá trị thời sự của trách nhiệm nêu gương</Name>
    </NodeName>
    <SortOrder>10</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
