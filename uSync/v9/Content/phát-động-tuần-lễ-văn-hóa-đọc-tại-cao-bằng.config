    <NodeName Default="Phát động tuần lễ văn hóa đọc tại Cao Bằng">
      <Name Culture="en-us">Launch of Reading Culture Week in Cao Bang</Name>
      <Name Culture="vi-vn">Phát động tuần lễ văn hóa đọc tại Cao Bằng</Name>
    </NodeName>
