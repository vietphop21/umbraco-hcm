    <NodeName Default="Người nông dân giúp dân phát triển kinh tế tại Cao Bằng">
      <Name Culture="en-us">A Farmer Helping People Develop the Economy in Cao Bang</Name>
      <Name Culture="vi-vn">Người nông dân giúp dân phát triển kinh tế tại Cao Bằng</Name>
    </NodeName>
    <SortOrder>25</SortOrder>
    <Published Default="true">
