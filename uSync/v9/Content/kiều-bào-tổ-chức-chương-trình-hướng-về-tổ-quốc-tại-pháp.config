    <NodeName Default="Kiều bào tổ chức chương trình hướng về Tổ quốc tại Pháp">
      <Name Culture="en-us">Overseas Vietnamese Hold a Program Dedicated to the Homeland in France</Name>
      <Name Culture="vi-vn">Kiều bào tổ chức chương trình hướng về Tổ quốc tại Pháp</Name>
    </NodeName>
    <SortOrder>14</SortOrder>
    <Published Default="true">
