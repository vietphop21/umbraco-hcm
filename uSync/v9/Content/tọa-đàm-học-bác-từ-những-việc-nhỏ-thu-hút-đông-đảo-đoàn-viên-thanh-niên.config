    <NodeName Default="Tọa đàm “Học Bác từ những việc nhỏ” thu hút đông đảo đoàn viên thanh niên">
      <Name Culture="en-us">Seminar “Learning from Uncle Ho Through Small Deeds” Attracts Large Numbers of Youth Union Members</Name>
      <Name Culture="vi-vn">Tọa đàm “Học Bác từ những việc nhỏ” thu hút đông đảo đoàn viên thanh niên</Name>
    </NodeName>
    <SortOrder>1</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
