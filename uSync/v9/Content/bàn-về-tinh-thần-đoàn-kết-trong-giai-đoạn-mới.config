    <NodeName Default="Bàn về tinh thần đoàn kết trong giai đoạn mới">
      <Name Culture="en-us">On the Spirit of Solidarity in the New Period</Name>
      <Name Culture="vi-vn">Bàn về tinh thần đoàn kết trong giai đoạn mới</Name>
    </NodeName>
    <SortOrder>24</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
