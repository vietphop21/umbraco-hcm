    <NodeName Default="Tọa đàm về tuần lễ văn hóa đọc tại Cần Thơ">
      <Name Culture="en-us">Seminar on Reading Culture Week in Can Tho</Name>
      <Name Culture="vi-vn">Tọa đàm về tuần lễ văn hóa đọc tại Cần Thơ</Name>
    </NodeName>
    <SortOrder>32</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
