    <NodeName Default="Trưng bày chuyên đề tư liệu, hiện vật về những năm tháng hoạt động cách mạng">
      <Name Culture="en-us">Thematic Display of Documents and Artefacts on the Years of Revolutionary Activity</Name>
      <Name Culture="vi-vn">Trưng bày chuyên đề tư liệu, hiện vật về những năm tháng hoạt động cách mạng</Name>
    </NodeName>
    <SortOrder>2</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
