    <NodeName Default="Kiều bào tổ chức chương trình hướng về Tổ quốc tại Ấn Độ">
      <Name Culture="en-us">Overseas Vietnamese Hold a Program Dedicated to the Homeland in India</Name>
      <Name Culture="vi-vn">Kiều bào tổ chức chương trình hướng về Tổ quốc tại Ấn Độ</Name>
    </NodeName>
    <SortOrder>18</SortOrder>
