    <NodeName Default="Bà mẹ già 30 năm nấu cháo miễn phí cho bệnh nhân nghèo">
      <Name Culture="en-us">Elderly Mother Cooks Free Rice Porridge for Poor Patients for 30 Years</Name>
      <Name Culture="vi-vn">Bà mẹ già 30 năm nấu cháo miễn phí cho bệnh nhân nghèo</Name>
    </NodeName>
    <SortOrder>7</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
