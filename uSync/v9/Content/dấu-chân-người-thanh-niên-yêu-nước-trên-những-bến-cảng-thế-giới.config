<Content Key="c08adbd1-a219-4c6b-8910-b938eca2aefa" Alias="Dấu chân người thanh niên yêu nước trên những bến cảng thế giới" Level="4">
  <Info>
    <Parent Key="f54f72dc-3dee-449b-9a62-274ac9bff21c">Hoạt động quốc tế</Parent>
