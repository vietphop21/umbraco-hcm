<Content Key="166c56af-480f-4a81-b171-35ce26544a6e" Alias="Tư tưởng về đại đoàn kết toàn dân tộc trong giai đoạn mới" Level="4">
  <Info>
    <Parent Key="6cef87da-59ed-45a4-8db8-7d16a045b3ec">Nội dung tư tưởng đạo đức</Parent>
    <Path>/TrangChu/TuTuongDaoDucPhongCachHoChiMinh/NoiDungTuTuongDaoDuc/TuTuongVeDaiDoanKetToanDanTocTrongGiaiDoanMoi</Path>
