    <NodeName Default="Doanh nhân trẻ lặng lẽ làm việc thiện suốt nhiều năm tại Thừa Thiên Huế">
      <Name Culture="en-us">A Young Entrepreneur Quietly Doing Charity Work for Many Years in Thua Thien Hue</Name>
      <Name Culture="vi-vn">Doanh nhân trẻ lặng lẽ làm việc thiện suốt nhiều năm tại Thừa Thiên Huế</Name>
    </NodeName>
    <SortOrder>28</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
