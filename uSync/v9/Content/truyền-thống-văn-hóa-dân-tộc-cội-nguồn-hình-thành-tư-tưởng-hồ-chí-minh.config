      <Name Culture="en-us">National Cultural Traditions – The Roots of Ho Chi Minh Thought</Name>
      <Name Culture="vi-vn">Truyền thống văn hóa dân tộc – cội nguồn hình thành tư tưởng Hồ Chí Minh</Name>
    </NodeName>
    <SortOrder>0</SortOrder>
