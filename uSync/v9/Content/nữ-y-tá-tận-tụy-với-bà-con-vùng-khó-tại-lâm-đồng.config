    <NodeName Default="Nữ y tá tận tụy với bà con vùng khó tại Lâm Đồng">
      <Name Culture="en-us">Nurse Devoted to People in Disadvantaged Areas of Lam Dong</Name>
      <Name Culture="vi-vn">Nữ y tá tận tụy với bà con vùng khó tại Lâm Đồng</Name>
    </NodeName>
    <SortOrder>21</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
