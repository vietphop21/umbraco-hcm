    <NodeName Default="Các chuyến thăm hữu nghị góp phần mở rộng quan hệ quốc tế">
      <Name Culture="en-us">Friendship Visits Contribute to Expanding International Relations</Name>
      <Name Culture="vi-vn">Các chuyến thăm hữu nghị góp phần mở rộng quan hệ quốc tế</Name>
    </NodeName>
    <SortOrder>3</SortOrder>
    <Published Default="true">
