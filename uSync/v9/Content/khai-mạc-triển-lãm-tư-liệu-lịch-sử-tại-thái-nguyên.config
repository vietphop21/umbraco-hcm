    <NodeName Default="Khai mạc triển lãm tư liệu lịch sử tại Thái Nguyên">
      <Name Culture="en-us">Opening of a Historical Documents Exhibition in Thai Nguyen</Name>
      <Name Culture="vi-vn">Khai mạc triển lãm tư liệu lịch sử tại Thái Nguyên</Name>
    </NodeName>
    <SortOrder>28</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
