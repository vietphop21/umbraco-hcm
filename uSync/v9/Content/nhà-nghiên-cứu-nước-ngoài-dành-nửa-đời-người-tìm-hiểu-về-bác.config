<Content Key="76a5624e-3e5f-4328-b3a1-4dabfce2a382" Alias="Nhà nghiên cứu nước ngoài dành nửa đời người tìm hiểu về Bác" Level="4">
  <Info>
    <Parent Key="7094342f-248e-4814-b944-047f5e8b6381">Bạn bè quốc tế</Parent>
