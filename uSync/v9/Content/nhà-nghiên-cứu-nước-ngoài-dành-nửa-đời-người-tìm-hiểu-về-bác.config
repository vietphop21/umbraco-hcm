    <NodeName Default="Nhà nghiên cứu nước ngoài dành nửa đời người tìm hiểu về Bác">
      <Name Culture="en-us">Foreign Researcher Devotes Half a Lifetime to Studying Uncle Ho</Name>
      <Name Culture="vi-vn">Nhà nghiên cứu nước ngoài dành nửa đời người tìm hiểu về Bác</Name>
    </NodeName>
    <SortOrder>2</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
