    <NodeName Default="Giới thiệu tư liệu về Chủ tịch Hồ Chí Minh tại Mông Cổ">
      <Name Culture="en-us">Introducing Documents on President Ho Chi Minh in Mongolia</Name>
      <Name Culture="vi-vn">Giới thiệu tư liệu về Chủ tịch Hồ Chí Minh tại Mông Cổ</Name>
    </NodeName>
    <SortOrder>13</SortOrder>
