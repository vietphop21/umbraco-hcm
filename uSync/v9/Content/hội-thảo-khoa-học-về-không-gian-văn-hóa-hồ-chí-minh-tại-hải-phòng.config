    <NodeName Default="Hội thảo khoa học về không gian văn hóa Hồ Chí Minh tại Hải Phòng">
      <Name Culture="en-us">Scientific Conference on the Ho Chi Minh Cultural Space in Hai Phong</Name>
      <Name Culture="vi-vn">Hội thảo khoa học về không gian văn hóa Hồ Chí Minh tại Hải Phòng</Name>
    </NodeName>
