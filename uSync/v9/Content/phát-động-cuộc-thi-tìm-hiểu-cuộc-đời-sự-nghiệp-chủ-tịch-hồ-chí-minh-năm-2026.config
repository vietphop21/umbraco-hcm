    <NodeName Default="Phát động cuộc thi tìm hiểu cuộc đời, sự nghiệp Chủ tịch Hồ Chí Minh năm 2026">
      <Name Culture="en-us">Launch of the 2026 Contest on the Life and Career of President Ho Chi Minh</Name>
      <Name Culture="vi-vn">Phát động cuộc thi tìm hiểu cuộc đời, sự nghiệp Chủ tịch Hồ Chí Minh năm 2026</Name>
    </NodeName>
    <SortOrder>3</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
