    <NodeName Default="Bí thư chi bộ giúp dân phát triển kinh tế tại Thái Nguyên">
      <Name Culture="en-us">Party Cell Secretary Helps Residents Develop the Economy in Thai Nguyen</Name>
      <Name Culture="vi-vn">Bí thư chi bộ giúp dân phát triển kinh tế tại Thái Nguyên</Name>
    </NodeName>
