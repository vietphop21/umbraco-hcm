    <NodeName Default="Tổng kết không gian văn hóa Hồ Chí Minh tại Cao Bằng">
      <Name Culture="en-us">Review of the Ho Chi Minh Cultural Space in Cao Bang</Name>
      <Name Culture="vi-vn">Tổng kết không gian văn hóa Hồ Chí Minh tại Cao Bằng</Name>
    </NodeName>
