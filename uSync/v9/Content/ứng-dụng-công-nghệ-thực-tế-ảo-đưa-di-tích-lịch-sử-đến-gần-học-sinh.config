    <NodeName Default="Ứng dụng công nghệ thực tế ảo đưa di tích lịch sử đến gần học sinh">
      <Name Culture="en-us">Applying Virtual Reality Technology to Bring Historical Relics Closer to Students</Name>
      <Name Culture="vi-vn">Ứng dụng công nghệ thực tế ảo đưa di tích lịch sử đến gần học sinh</Name>
    </NodeName>
    <SortOrder>9</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
    </Published>
