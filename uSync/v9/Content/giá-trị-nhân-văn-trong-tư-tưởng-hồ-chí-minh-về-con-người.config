    <NodeName Default="Giá trị nhân văn trong tư tưởng Hồ Chí Minh về con người">
      <Name Culture="en-us">Humanistic Values in Ho Chi Minh's Thought on the Human Being</Name>
      <Name Culture="vi-vn">Giá trị nhân văn trong tư tưởng Hồ Chí Minh về con người</Name>
    </NodeName>
    <SortOrder>3</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
