    <NodeName Default="Bàn về trách nhiệm nêu gương trong giai đoạn mới">
      <Name Culture="en-us">On the Responsibility to Set an Example in the New Period</Name>
      <Name Culture="vi-vn">Bàn về trách nhiệm nêu gương trong giai đoạn mới</Name>
    </NodeName>
    <SortOrder>4</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
    </Published>
