    <NodeName Default="Tổ chức chuyên đề học tập năm 2026 tại Nghệ An">
      <Name Culture="en-us">Organising the 2026 Thematic Study Programme in Nghe An</Name>
      <Name Culture="vi-vn">Tổ chức chuyên đề học tập năm 2026 tại Nghệ An</Name>
    </NodeName>
    <SortOrder>13</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
