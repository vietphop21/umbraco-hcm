    <NodeName Default="Số hóa hàng nghìn trang tư liệu quý phục vụ nghiên cứu và giáo dục">
      <Name Culture="en-us">Thousands of Pages of Valuable Documents Digitised for Research and Education</Name>
      <Name Culture="vi-vn">Số hóa hàng nghìn trang tư liệu quý phục vụ nghiên cứu và giáo dục</Name>
    </NodeName>
