    <NodeName Default="Bàn về đạo đức cách mạng trong giai đoạn mới">
      <Name Culture="en-us">On Revolutionary Ethics in the New Period</Name>
      <Name Culture="vi-vn">Bàn về đạo đức cách mạng trong giai đoạn mới</Name>
    </NodeName>
