    <NodeName Default="Sinh viên tình nguyện lặng lẽ làm việc thiện suốt nhiều năm tại Đà Nẵng">
      <Name Culture="en-us">Volunteer Students Quietly Doing Charitable Work for Many Years in Da Nang</Name>
      <Name Culture="vi-vn">Sinh viên tình nguyện lặng lẽ làm việc thiện suốt nhiều năm tại Đà Nẵng</Name>
    </NodeName>
