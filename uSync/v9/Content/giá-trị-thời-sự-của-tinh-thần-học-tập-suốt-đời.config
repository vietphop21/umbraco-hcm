    <NodeName Default="Giá trị thời sự của tinh thần học tập suốt đời">
      <Name Culture="en-us">The Contemporary Relevance of the Spirit of Lifelong Learning</Name>
      <Name Culture="vi-vn">Giá trị thời sự của tinh thần học tập suốt đời</Name>
    </NodeName>
