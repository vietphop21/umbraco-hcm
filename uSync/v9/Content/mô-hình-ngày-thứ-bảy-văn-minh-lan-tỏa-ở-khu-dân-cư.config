    <NodeName Default="Mô hình “Ngày thứ bảy văn minh” lan tỏa ở khu dân cư">
      <Name Culture="en-us">The &quot;Civilized Saturday&quot; Model Spreads Across Residential Areas</Name>
      <Name Culture="vi-vn">Mô hình “Ngày thứ bảy văn minh” lan tỏa ở khu dân cư</Name>
    </NodeName>
    <SortOrder>9</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
