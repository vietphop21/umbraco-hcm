    <NodeName Default="Ra mắt không gian văn hóa đọc về Chủ tịch Hồ Chí Minh tại thư viện tỉnh">
      <Name Culture="en-us">Launch of a Reading Culture Space on President Ho Chi Minh at the Provincial Library</Name>
      <Name Culture="vi-vn">Ra mắt không gian văn hóa đọc về Chủ tịch Hồ Chí Minh tại thư viện tỉnh</Name>
    </NodeName>
    <SortOrder>0</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
    </Published>
