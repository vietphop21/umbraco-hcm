    <NodeName Default="Khai mạc lớp bồi dưỡng chuyên đề tư tưởng, đạo đức, phong cách cho cán bộ trẻ">
      <Name Culture="en-us">Opening of a Thematic Training Course on Ho Chi Minh's Thought, Morality and Style for Young Officials</Name>
      <Name Culture="vi-vn">Khai mạc lớp bồi dưỡng chuyên đề tư tưởng, đạo đức, phong cách cho cán bộ trẻ</Name>
    </NodeName>
    <SortOrder>6</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
