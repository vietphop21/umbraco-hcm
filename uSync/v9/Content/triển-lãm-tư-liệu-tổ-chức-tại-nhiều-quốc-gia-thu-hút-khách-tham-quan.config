    <NodeName Default="Triển lãm tư liệu tổ chức tại nhiều quốc gia thu hút khách tham quan">
      <Name Culture="en-us">Documentary Exhibitions Held in Many Countries Attract Visitors</Name>
      <Name Culture="vi-vn">Triển lãm tư liệu tổ chức tại nhiều quốc gia thu hút khách tham quan</Name>
    </NodeName>
