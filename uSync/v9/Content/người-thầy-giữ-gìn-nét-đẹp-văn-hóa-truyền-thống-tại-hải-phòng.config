    <NodeName Default="Người thầy giữ gìn nét đẹp văn hóa truyền thống tại Hải Phòng">
      <Name Culture="en-us">A Teacher Preserving Traditional Cultural Beauty in Hai Phong</Name>
      <Name Culture="vi-vn">Người thầy giữ gìn nét đẹp văn hóa truyền thống tại Hải Phòng</Name>
    </NodeName>
    <SortOrder>20</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
