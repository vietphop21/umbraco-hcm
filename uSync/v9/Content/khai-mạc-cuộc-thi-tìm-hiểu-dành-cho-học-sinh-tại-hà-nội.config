    <NodeName Default="Khai mạc cuộc thi tìm hiểu dành cho học sinh tại Hà Nội">
      <Name Culture="en-us">Opening of a Knowledge Contest for Students in Hanoi</Name>
      <Name Culture="vi-vn">Khai mạc cuộc thi tìm hiểu dành cho học sinh tại Hà Nội</Name>
    </NodeName>
    <SortOrder>36</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
