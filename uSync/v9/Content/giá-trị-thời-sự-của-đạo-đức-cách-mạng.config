    <NodeName Default="Giá trị thời sự của đạo đức cách mạng">
      <Name Culture="en-us">The Contemporary Relevance of Revolutionary Morality</Name>
      <Name Culture="vi-vn">Giá trị thời sự của đạo đức cách mạng</Name>
    </NodeName>
    <SortOrder>6</SortOrder>
