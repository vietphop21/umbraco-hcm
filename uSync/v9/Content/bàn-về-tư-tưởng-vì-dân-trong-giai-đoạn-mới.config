    <NodeName Default="Bàn về tư tưởng vì dân trong giai đoạn mới">
      <Name Culture="en-us">On the People-Centred Ideology in the New Period</Name>
      <Name Culture="vi-vn">Bàn về tư tưởng vì dân trong giai đoạn mới</Name>
    </NodeName>
    <SortOrder>5</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
