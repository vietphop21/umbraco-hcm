    <NodeName Default="Hoạt động ngoại giao trong những năm đầu xây dựng nhà nước mới">
      <Name Culture="en-us">Diplomatic Activities in the Early Years of Building the New State</Name>
      <Name Culture="vi-vn">Hoạt động ngoại giao trong những năm đầu xây dựng nhà nước mới</Name>
    </NodeName>
    <SortOrder>2</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
