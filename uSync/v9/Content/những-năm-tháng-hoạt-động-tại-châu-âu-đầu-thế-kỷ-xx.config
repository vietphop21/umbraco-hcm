    <NodeName Default="Những năm tháng hoạt động tại châu Âu đầu thế kỷ XX">
      <Name Culture="en-us">Years of Activity in Europe in the Early 20th Century</Name>
      <Name Culture="vi-vn">Những năm tháng hoạt động tại châu Âu đầu thế kỷ XX</Name>
    </NodeName>
