    <NodeName Default="Vận dụng ý chí tự lực tự cường trong công tác cán bộ">
      <Name Culture="en-us">Applying the Will of Self-Reliance and Self-Strengthening in Cadre Work</Name>
      <Name Culture="vi-vn">Vận dụng ý chí tự lực tự cường trong công tác cán bộ</Name>
    </NodeName>
    <SortOrder>20</SortOrder>
