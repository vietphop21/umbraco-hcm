    <NodeName Default="Ra mắt bộ tài liệu điện tử phục vụ sinh hoạt chi bộ chuyên đề">
      <Name Culture="en-us">Launch of an Electronic Document Set for Thematic Party Cell Meetings</Name>
      <Name Culture="vi-vn">Ra mắt bộ tài liệu điện tử phục vụ sinh hoạt chi bộ chuyên đề</Name>
    </NodeName>
    <SortOrder>11</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
