    <NodeName Default="Vận dụng đạo đức cách mạng trong công tác cán bộ">
      <Name Culture="en-us">Applying Revolutionary Ethics in Cadre Work</Name>
      <Name Culture="vi-vn">Vận dụng đạo đức cách mạng trong công tác cán bộ</Name>
    </NodeName>
    <SortOrder>14</SortOrder>
