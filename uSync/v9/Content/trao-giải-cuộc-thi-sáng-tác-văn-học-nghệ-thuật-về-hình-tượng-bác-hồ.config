    <NodeName Default="Trao giải cuộc thi sáng tác văn học nghệ thuật về hình tượng Bác Hồ">
      <Name Culture="en-us">Awards Presented in the Literary and Artistic Creation Contest on the Image of Uncle Ho</Name>
      <Name Culture="vi-vn">Trao giải cuộc thi sáng tác văn học nghệ thuật về hình tượng Bác Hồ</Name>
    </NodeName>
    <SortOrder>10</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
      <Published Culture="vi-vn">true</Published>
