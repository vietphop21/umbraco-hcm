    <NodeName Default="Cựu chiến binh sáng tạo trong lao động sản xuất tại TP. Hồ Chí Minh">
      <Name Culture="en-us">A Veteran's Creativity in Labour and Production in Ho Chi Minh City</Name>
      <Name Culture="vi-vn">Cựu chiến binh sáng tạo trong lao động sản xuất tại TP. Hồ Chí Minh</Name>
    </NodeName>
    <SortOrder>12</SortOrder>
