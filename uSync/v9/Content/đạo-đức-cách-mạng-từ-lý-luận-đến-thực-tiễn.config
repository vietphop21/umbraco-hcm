      <Name Culture="en-us">Revolutionary Ethics – From Theory to Practice</Name>
      <Name Culture="vi-vn">Đạo đức cách mạng – từ lý luận đến thực tiễn</Name>
    </NodeName>
    <SortOrder>16</SortOrder>
