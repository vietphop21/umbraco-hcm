<Content Key="1b16e4cf-6cbb-40ab-a86d-df24167fd499" Alias="Phát huy phương pháp nêu gương trong xây dựng đội ngũ cán bộ" Level="4">
  <Info>
    <Parent Key="6cef87da-59ed-45a4-8db8-7d16a045b3ec">Nội dung tư tưởng đạo đức</Parent>
    <Path>/TrangChu/TuTuongDaoDucPhongCachHoChiMinh/NoiDungTuTuongDaoDuc/PhatHuyPhuongPhapNeuGuongTrongXayDungDoiNguCanBo</Path>
