    <NodeName Default="Tinh thần học tập suốt đời – từ lý luận đến thực tiễn">
      <Name Culture="en-us">The Spirit of Lifelong Learning – From Theory to Practice</Name>
      <Name Culture="vi-vn">Tinh thần học tập suốt đời – từ lý luận đến thực tiễn</Name>
    </NodeName>
