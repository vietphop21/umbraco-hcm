    <NodeName Default="Phim tài liệu: Hành trình tìm đường cứu nước">
      <Name Culture="en-us">Documentary: The Journey to Find a Way to Save the Nation</Name>
      <Name Culture="vi-vn">Phim tài liệu: Hành trình tìm đường cứu nước</Name>
    </NodeName>
