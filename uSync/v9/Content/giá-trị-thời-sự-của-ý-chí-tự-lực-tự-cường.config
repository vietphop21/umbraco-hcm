    <NodeName Default="Giá trị thời sự của ý chí tự lực tự cường">
      <Name Culture="en-us">The Contemporary Relevance of the Will for Self-Reliance and Self-Strengthening</Name>
      <Name Culture="vi-vn">Giá trị thời sự của ý chí tự lực tự cường</Name>
    </NodeName>
