    <NodeName Default="Người nông dân giữ gìn nét đẹp văn hóa truyền thống tại Tuyên Quang">
      <Name Culture="en-us">A Farmer Preserving Traditional Cultural Beauty in Tuyen Quang</Name>
      <Name Culture="vi-vn">Người nông dân giữ gìn nét đẹp văn hóa truyền thống tại Tuyên Quang</Name>
    </NodeName>
    <SortOrder>15</SortOrder>
    <Published Default="true">
      <Published Culture="en-us">true</Published>
