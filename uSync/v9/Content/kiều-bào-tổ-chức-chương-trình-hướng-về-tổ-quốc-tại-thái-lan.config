    <NodeName Default="Kiều bào tổ chức chương trình hướng về Tổ quốc tại Thái Lan">
      <Name Culture="en-us">Overseas Vietnamese Hold a Program Dedicated to the Homeland in Thailand</Name>
      <Name Culture="vi-vn">Kiều bào tổ chức chương trình hướng về Tổ quốc tại Thái Lan</Name>
    </NodeName>
    <SortOrder>19</SortOrder>
